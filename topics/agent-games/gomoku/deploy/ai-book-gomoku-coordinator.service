[Unit]
Description=AI_book GAME-001 GitHub referee watchdog (NO AI player)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ai_book_gomoku_coordinator
Environment=PYTHONUNBUFFERED=1
Environment=AI_BOOK_GITHUB_TOKEN_FILE=%h/.config/ai-book-gomoku/github-token
ExecStart=/usr/bin/python3 %h/ai_book_gomoku_coordinator/topics/agent-games/gomoku/scripts/coordinator.py --loop --interval 10 --dispatch --grace 45 --cooldown 180
Restart=on-failure
RestartSec=20
NoNewPrivileges=true

[Install]
WantedBy=default.target
